<Root>
  <Window title="Menu">
    <Menu>
      <MenuBar>
        <MenuBarItem name="file">File</MenuBarItem>
        <MenuBarItem name="edit">Edit</MenuBarItem>
        <MenuBarItem name="view">View</MenuBarItem>
        <MenuBarItem name="help">Help</MenuBarItem>
      </MenuBar>
      <SubMenu>
        <MenuBox belongsTo="file">
          <MenuBoxItem>Open</MenuBoxItem>
          <MenuBoxItem>Save</MenuBoxItem>
          <MenuBoxItem name="recent" submenu="true">Recent files</MenuBoxItem>
          <MenuBoxItem>Quit</MenuBoxItem>
        </MenuBox>
        <MenuBox belongsTo="recent" submenu="true">
          <MenuBoxItem>example-one.txt</MenuBoxItem>
          <MenuBoxItem>example-two.txt</MenuBoxItem>
        </MenuBox>
        <MenuBox belongsTo="edit">
          <MenuBoxItem>Cut</MenuBoxItem>
          <MenuBoxItem>Copy</MenuBoxItem>
          <MenuBoxItem>Paste</MenuBoxItem>
        </MenuBox>
        <MenuBox belongsTo="view">
          <MenuBoxItem selected="true">Status bar</MenuBoxItem>
          <MenuBoxItem>Refresh</MenuBoxItem>
        </MenuBox>
        <MenuBox belongsTo="help">
          <MenuBoxItem>About</MenuBoxItem>
        </MenuBox>
      </SubMenu>
    </Menu>
  </Window>
</Root>
