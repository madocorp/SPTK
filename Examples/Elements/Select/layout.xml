<Root>
  <Window title="Select">
    <Panel name="panel">
      <PanelTitle>Select</PanelTitle>
      <PanelContent>
        <Label>
          Favorite color:
          <Select name="color" hint="Choose a color">
            <Option>Red</Option>
            <Option>Green</Option>
            <Option>Blue</Option>
            <Option>Purple</Option>
          </Select>
        </Label>
        <Label>
          Mood:
          <Select name="mood" hint="Choose a mood" options="Calm, Focused, Curious, Tired" />
        </Label>
        <Label>
          Random note:
          <Input name="note" placeholder="Type something" />
        </Label>
        <Label>
          Enabled:
          <CheckBox name="enabled" value="true" />
        </Label>
      </PanelContent>
    </Panel>
  </Window>
</Root>
