<Screen>
  <Layout direction="vertical">
    <Text height="1">Lists: Type a prefix or use Space to toggle</Text>
    <Separator />
    <Layout direction="horizontal" height="1*">
      <List width="1*" reorderable="true">
        <Item value="alpha">Alpha</Item>
        <Item value="beta" selected="true">Beta</Item>
        <Item value="gamma">Gamma</Item>
        <Item value="delta">Delta</Item>
        <Item value="epsilon">Epsilon</Item>
        <Event type="change" action="Controller::listChanged" />
      </List>
      <Separator />
      <List width="1*" multiple="true" filterable="true">
        <Item value="apples" selected="true">Apples</Item>
        <Item value="bananas">Bananas</Item>
        <Item value="cherries">Cherries</Item>
        <Item value="dates">Dates</Item>
        <Item value="elderberries">Elderberries</Item>
        <Event type="change" action="Controller::listChanged" />
      </List>
    </Layout>
  </Layout>
</Screen>
