<Screen>
  <Layout direction="vertical">
    <Text height="1">List: Type a prefix | Space toggles choices | Return activates</Text>
    <Separator />
    <Layout direction="horizontal" height="1*">
      <List width="1*" reorderable="true">
        <Item value="alpha">Alpha</Item>
        <Item value="beta" selected="true">Beta</Item>
        <Item value="gamma">Gamma</Item>
        <Item value="delta">Delta</Item>
        <Item value="epsilon">Epsilon</Item>
        <Event type="change" action="Controller::listChanged" />
      </List>
      <Separator />
      <List width="1*" multiple="true" filterable="true">
        <Item value="apples" selected="true">Apples</Item>
        <Item value="bananas">Bananas</Item>
        <Item value="cherries">Cherries</Item>
        <Item value="dates">Dates</Item>
        <Item value="elderberries">Elderberries</Item>
        <Event type="change" action="Controller::listChanged" />
      </List>
    </Layout>
    <Separator />
    <Layout direction="horizontal" height="1*">
      <RadioButton width="1*">
        <Item value="local" checked="true">Local database</Item>
        <Item value="remote">Remote database</Item>
        <Item value="memory">In-memory database</Item>
        <Event type="change" action="Controller::choiceChanged" />
      </RadioButton>
      <Separator />
      <CheckboxArray width="1*">
        <Item value="tables" checked="true">Show tables</Item>
        <Item value="views">Show views</Item>
        <Item value="indexes">Show indexes</Item>
        <Item value="triggers">Show triggers</Item>
        <Event type="change" action="Controller::choiceChanged" />
      </CheckboxArray>
    </Layout>
  </Layout>
</Screen>
