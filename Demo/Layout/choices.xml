<Screen>
  <Event type="keyDown" key="f1" action="Controller::showMain" />
  <Event type="keyDown" key="f2" action="Controller::showEditors" />
  <Event type="keyDown" key="f4" action="Controller::showLists" />
  <Event type="keyDown" key="f5" action="Controller::showImages" />
  <Layout direction="vertical">
    <Text height="1">Choices: F1 main | F2 editors | F4 lists | F5 images | Space toggle</Text>
    <Separator />
    <Layout direction="horizontal" height="1*">
      <RadioButton width="1*">
        <Item value="local" checked="true">Local database</Item>
        <Item value="remote">Remote database</Item>
        <Item value="memory">In-memory database</Item>
        <Event type="change" action="Controller::choiceChanged" />
      </RadioButton>
      <Separator />
      <CheckboxArray width="1*">
        <Item value="tables" checked="true">Show tables</Item>
        <Item value="views">Show views</Item>
        <Item value="indexes">Show indexes</Item>
        <Item value="triggers">Show triggers</Item>
        <Event type="change" action="Controller::choiceChanged" />
      </CheckboxArray>
    </Layout>
  </Layout>
</Screen>
